{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "steps": {
    "install": {
      "commands": [
        "pip install --upgrade pip && pip install -r requirements.txt"
      ]
    }
  },
  "deploy": {
    "startCommand": "python -m shiny run --host 0.0.0.0 --port ${PORT:-8000} gui_ml_upc.py"
  }
}